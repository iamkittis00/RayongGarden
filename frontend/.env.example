# Copy to .env and fill in real values. Never commit .env.
#
# Google Maps JavaScript API key (Google Cloud Console > APIs & Services > Credentials).
# NOTE: every VITE_* value is baked into the browser bundle in plaintext, so this key
# is public by nature. Protect it with restrictions, not secrecy:
#   - Application restriction: HTTP referrers -> only this project's domain(s)
#   - API restriction: Maps JavaScript API only
VITE_GOOGLE_MAPS_API_KEY=changeme
